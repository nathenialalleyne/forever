<?xml version="1.0"?>
<!DOCTYPE module PUBLIC
	"-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
	"https://checkstyle.org/dtds/configuration_1_3.dtd">
<module name="Checker">
	<!-- Java sources are compiled as UTF-8 everywhere in the root build. Keeping the
		checker on the same encoding prevents a lint result from changing by platform. -->
	<property name="charset" value="UTF-8"/>
	<property name="fileExtensions" value="java"/>

	<!-- A small, line-specific ratchet is preferable to disabling a useful rule for a
		whole source set. The exceptions describe existing code that is intentionally
		outside the default convention. -->
	<module name="SuppressionFilter">
		<property name="file" value="${config_loc}/suppressions.xml"/>
	</module>

	<!-- The project uses tabs for Java indentation. FileTabCharacter is therefore not
		appropriate here. Trailing whitespace is still unambiguous noise. -->
	<module name="RegexpSingleline">
		<property name="format" value="[ \t]+$"/>
		<property name="maximum" value="0"/>
		<property name="message" value="Trailing whitespace is not allowed."/>
	</module>

	<!-- Keep ordinary production lines near the project's roughly 120-column convention
		without demanding a wholesale rewrite of existing fixture literals. The pre-ratchet
		baseline found 28 common/server findings at the old max of 140. The current
		non-suppressed maximum is 162 columns in core/settlement/Settlement.java. This is
		a high-water-mark ceiling, not a target. Simplify future failures where possible,
		and lower the ceiling over time rather than raising it without a recorded reason. -->
	<module name="LineLength">
		<property name="severity" value="error"/>
		<property name="max" value="162"/>
	</module>

	<!-- The asset validator is a command-line boundary, so its deliberate hand-off to
		standard streams is the one non-logger stream in the repository. -->
	<module name="RegexpSingleline">
		<property name="format" value="\bSystem\.(?:out|err)\b"/>
		<property name="maximum" value="0"/>
		<property name="message" value="Use the project's logger instead of System.out or System.err."/>
	</module>

	<module name="FileLength">
		<property name="max" value="450"/>
	</module>

	<module name="TreeWalker">
		<!-- Imports are kept explicit because wildcard and dead imports obscure the
			actual dependency boundary between Forever source sets. -->
		<module name="AvoidStarImport"/>
		<module name="RedundantImport"/>
		<module name="UnusedImports"/>

		<!-- These checks enforce the existing brace and whitespace convention without
			asking a formatter to change tabs, continuation layout, or line wrapping. -->
		<module name="NeedBraces"/>
		<module name="WhitespaceAfter"/>
		<module name="WhitespaceAround"/>
		<module name="NoWhitespaceBefore"/>
		<module name="OneStatementPerLine"/>
		<module name="ArrayTypeStyle"/>
		<module name="ModifierOrder"/>
		<module name="RedundantModifier"/>
		<!-- A class with only private constructors cannot be extended in practice. Making
			that closed design explicit protects immutable and utility boundaries without
			adding final to every mutable local; records are already implicitly final. -->
		<module name="FinalClass"/>

		<!-- A switch STATEMENT over an enum is not exhaustiveness-checked by the Java
			compiler, even with arrow labels. Only a switch EXPRESSION is. So a new enum
			constant can silently reach no branch at all, which is a real fail-open risk
			at a compatibility or persistence boundary. Requiring a default makes that
			case observable. Prefer a default that logs or throws with the unexpected
			value named, never a silent no-op. -->
		<module name="MissingSwitchDefault"/>
		<module name="DefaultComesLast"/>
		<module name="FallThrough"/>

		<!-- Pairing these methods protects value semantics for non-record classes. -->
		<module name="EqualsHashCode"/>

		<!-- Broad exception catches and empty handlers hide actionable failures. The
			asset and game code must either handle a narrow failure or add context and
			rethrow it. RuntimeException is intentionally not blanket-banned because
			some server boundaries catch it to restore atomic state before rethrowing. -->
		<module name="IllegalCatch">
			<property name="illegalClassNames" value="java.lang.Exception,java.lang.Error,java.lang.Throwable"/>
		</module>
		<module name="EmptyCatchBlock"/>

		<!-- Named, bounded units make architecture boundaries visible. The pre-ratchet
			baseline found 33 parameter-count findings at the old max of four. The current
			maximum is 14 parameters in core/settlement/SettlementBalance.java. This is a
			high-water-mark ceiling, not a target. Simplify future failures where possible,
			and lower the ceiling over time rather than raising it without a recorded reason. -->
		<module name="ParameterNumber">
			<property name="severity" value="error"/>
			<property name="max" value="14"/>
		</module>
		<module name="MethodLength">
			<property name="max" value="100"/>
		</module>
		<module name="NestedIfDepth">
			<property name="max" value="3"/>
		</module>
		<module name="NestedTryDepth">
			<property name="max" value="1"/>
		</module>
		<module name="CyclomaticComplexity">
			<!-- The pre-ratchet baseline found 27 common/server findings at the old max of
				10. Those source sets currently peak at complexity 25 in
				core/storage/domain/StorageBalance.java. Asset tools have a separate bound
				because their old baseline added four findings and the RFC 4180 parser currently
				peaks at 29, with build.gradle supplying that developer-only source-set override.
				Both values are high-water-mark ceilings, not targets. Simplify future failures
				where possible, and lower the ceilings over time rather than raising them without
				a recorded reason. -->
			<property name="severity" value="error"/>
			<property name="max" value="${cyclomatic_max}"/>
		</module>

		<!-- Public types carry the substantive API and design prose. Methods are not
			required to carry filler comments, so JavadocMethod is deliberately absent. -->
		<module name="JavadocType">
			<property name="scope" value="public"/>
			<property name="allowMissingParamTags" value="true"/>
			<property name="tokens" value="CLASS_DEF,INTERFACE_DEF,ENUM_DEF,ANNOTATION_DEF,RECORD_DEF"/>
		</module>
	</module>
</module>
